# Copy to .env.local and fill in. TESTNET values only.

# Arc testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
VAULT_ADDRESS=

# Wallets
OWNER_ADDRESS=
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=
BROKER_ADDRESS=
BROKER_PRIVATE_KEY=

# Gemini sandbox (Trader role key from exchange.sandbox.gemini.com).
# Leave key/secret empty to run with simulated fills.
GEMINI_MARKETS_URL=https://api.gemini.com
GEMINI_BASE_URL=https://api.sandbox.gemini.com
GEMINI_API_KEY=
GEMINI_API_SECRET=

# ElevenLabs / QuickNode / Anthropic
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
QUICKNODE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# Shared secret ElevenLabs sends as the x-leash-secret header (openssl rand -hex 24)
TOOL_SECRET=
